# piNen root gitignore
# Blocks secrets, runtime state, personal project memory, and build artifacts

# Git
.git/

# Auth / secrets
agent/auth.json
agent/mcp.json
agent/gmail-config.json
*.env
*.env.*
*secret*
*token*
*credential*
*credentials*
*oauth*
*key*.json
!*.example.json
!*.template.json

# Runtime / state
agent/sessions/
agent/handoffs/
agent/scheduler.json
agent/verbosity-state.json
agent/mcp-cache.json
agent/trust.json
agent/nul

# NenFlow runs
agent/nenflow-v3/runs/
agent/nenflow-v3/runs/**/*

# Orchestration runs and generated lifecycle state
agent/orchestration/runs/
agent/orchestration/runs/**/*
agent/orchestrate-runs/
agent/orchestration-runs/
agent/orchestration-builder/runs/
agent/global-graphify-maintenance/runs/
pi-orchestrator-extension/runs-state/
pi-orchestrator-extension/intakes/
pi-orchestrator-extension/shape-builder-lifecycle/

# Diagnostics / traces
agent/diagnostics/
agent/*diagnostics*.json
agent/*diagnostics*.tmp-*
agent/engram-health-trace.jsonl
agent/tmp_search*.json
agent/crash-wall.md
agent/*handoff*.md
agent/*intake*.md
!agent/extensions/**/intake.md
agent/*report*.md
agent/continuation-task-*.md
agent/task-*-report.md
agent/new-mock-process-last-run.json
agent/graphify-test-bundle.js
agent/prompts/agent-new-session-*-live-*.md
*.jsonl
*.bak

# Graphify Brain (personal project memory)
# Only placeholder files are tracked; all project memories are ignored
graphify-brain/*
!graphify-brain/.gitkeep
!graphify-brain/README.md
graphify-out/
**/graphify-out/
.graphify_python
.graphify_*.json
.graphify_uncached.txt

# Core patch state
agent/core-patch/patch-manifest.json
agent/core-patch/backups/

# Telegram runtime
agent/telegram-pi/secret.token
agent/telegram-pi/state.json
agent/telegram-pi/heartbeat.json
agent/telegram-pi/daemon-state.json
agent/telegram-pi/logs/
agent/telegram-pi/config.json

# Graphify autonomy and backup runtime state
agent/graphify-autonomy/
agent/git-backup/config.json
agent/git-backup/state.json
agent/git-backup/run-log.jsonl
agent/git-backup/locks/
agent/git-backup/tmp/

# MCP runtime
**.playwright-mcp/**

# Binaries
*.exe
*.dll
*.pyd
*.so
*.dylib
*.zip
*.tar
*.tar.gz
*.7z
*.db
*.sqlite
*.sqlite3

# Media (except intentional skill resources)
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.mp4
*.wav
*.mp3
*.pdf

# Dependencies and nested source-control metadata
node_modules/
*/node_modules/
**/.git/
